<launch>
    <!-- Standard ROS Assignment Nodes -->
    <node pkg="ros_nodes" type="result_game.py" name="result_node" output="screen"/>
    <node pkg="ros_nodes" type="game_node.py" name="game_node" output="screen">
        <param name="change_player_color" value="2" />
    </node>
    
    <!-- GUI Node (The Actual Visual Game) - Waits for user info and difficulty/color selection -->
    <node pkg="ros_nodes" type="gui_node.py" name="gui_game_node" output="screen" />
    
    <!-- User Information Input Nodes - Both GUI and Terminal versions available -->
    <!-- GUI version (beautiful pygame GUI) -->
    <node pkg="ros_nodes" type="info_user_gui.py" name="info_user_gui" output="screen" />
    
    <!-- Terminal version (for terminal input) -->
    <node pkg="ros_nodes" type="info_user.py" name="info_user_terminal" output="screen" launch-prefix="xterm -e" />
    
    <!-- Difficulty and Color Select GUI - Shows after user info is collected -->
    <node pkg="ros_nodes" type="difficulty_select_gui.py" name="difficulty_select_gui" output="screen" />
    
    <!-- Control Node - Pygame version with real-time feedback display -->
    <node pkg="ros_nodes" type="control_node_pygame.py" name="control_node" output="screen" />
</launch>

