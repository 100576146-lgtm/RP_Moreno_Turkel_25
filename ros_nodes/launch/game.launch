<launch>
    <node pkg="ros_nodes" type="result_game.py" name="result_node" output="screen"/>
    <node pkg="ros_nodes" type="game_node.py" name="game_node" output="screen">
        <param name="change_player_color" value="2" />
    </node>
    <node pkg="ros_nodes" type="info_user.py" name="info_user" output="screen" launch-prefix="gnome-terminal --command" />
    <node pkg="ros_nodes" type="control_node.py" name="control_node" output="screen" launch-prefix="gnome-terminal --command" />
</launch>

